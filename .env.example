# Local server (Node 22.12+)
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Register a confidential Twitch app with this exact redirect URL.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
# observe (no Twitch actions) | assist | guardian. Observe is the safe first-run default.
DEFAULT_MODE=observe
# Delete every location guess regardless of confidence, so deletions never reveal which guess chat agrees on.
SWAT_ALL_GUESSES=false
MASCOT_NAME=Swatty
# Start with the scripted chat simulator on (also switchable from the dashboard).
DEMO_MODE=false
# Optional. Without a key, messages are classified by built-in rules only.
OPENAI_API_KEY=
# Cheapest current model per developers.openai.com/api/docs/models (checked 2026-10-30).
OPENAI_MODEL_TEXT=gpt-6-luna
AI_MAX_CALLS_PER_MINUTE=30
AI_TIMEOUT_MS=8000
# Detection tuning
PREFILTER_THRESHOLD=0.35
TRIANGULATION_WINDOW_MS=300000
SWARM_MIN_USERS=3
SWARM_MIN_SCORE=3.0
# Stretch milestones, not consumed yet:
# OPENAI_MODEL_VISION=gpt-6.1-terra
# OBS_ENABLED=false
